<Page
    x:Class="RTSSGameBar.Widget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Spacing="12">
            <TextBlock Text="RTSS Game Bar" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="This app is designed to run as an Xbox Game Bar widget. Press Win+G, open the Widget menu, and select RTSS Game Bar." TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="The desktop helper is launched by the widget and bridges commands to RTSSGameBarPlugin.dll running inside RTSS." TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
