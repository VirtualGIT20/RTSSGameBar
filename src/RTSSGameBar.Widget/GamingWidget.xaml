<Page
    x:Class="RTSSGameBar.Widget.GamingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="GameBarSurfaceBrush" Color="#25282C" />
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ControllerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ControllerToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="OnContent" Value="ON" />
            <Setter Property="OffContent" Value="OFF" />
        </Style>
        <Style x:Key="ControllerSliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="SnapsTo" Value="StepValues" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Game Bar no longer supplies a widget backplate. Use the same system chrome
             surface family as the controls instead of a custom hard-coded grey. -->
        <Border x:Name="WidgetBackground"
                IsHitTestVisible="False"
                Background="{StaticResource GameBarSurfaceBrush}" />

        <ScrollViewer x:Name="WidgetScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsTabStop="False">
            <Grid Padding="18" MinWidth="360">
                <StackPanel Spacing="14">
                    <!-- Compact in-widget identity. The Game Bar chrome already carries the title. -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/Square44x44Logo.png" Width="34" Height="34" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="RTSS Game Bar" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="v1.0.0" Opacity="0.66" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <!-- Status -->
                    <Border Padding="14" CornerRadius="10"
                            Background="{StaticResource GameBarSurfaceBrush}"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="RtssStatusLed" Width="9" Height="9" Fill="Gray" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="RTSS" VerticalAlignment="Center" FontSize="16" />
                                <TextBlock x:Name="RtssStateText" Grid.Column="2" Text="Checking…" FontSize="16" FontWeight="SemiBold" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="IntegrationStatusLed" Width="9" Height="9" Fill="Gray" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Integration" VerticalAlignment="Center" FontSize="16" />
                                <TextBlock x:Name="IntegrationStateText" Grid.Column="2" Text="Checking…" FontSize="16" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="DetailText" Text="Starting local bridge…" TextWrapping="Wrap" Opacity="0.72" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Frame limiter -->
                    <Border Padding="14" CornerRadius="10"
                            Background="{StaticResource GameBarSurfaceBrush}"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Frame limiter" FontSize="18" FontWeight="SemiBold" />

                            <!-- One native focus target: Left/Right changes the value directly. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="94" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FrameLimitSlider"
                                        Grid.Column="0"
                                        Style="{StaticResource ControllerSliderStyle}"
                                        Minimum="0" Maximum="1000"
                                        StepFrequency="1" SmallChange="1" LargeChange="10"
                                        ValueChanged="FrameLimitSlider_ValueChanged"
                                        AutomationProperties.Name="Frame limiter" />
                                <TextBlock x:Name="FrameLimitValueText"
                                           Grid.Column="1"
                                           Text="--"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <!-- A single controller stop replaces the five-preset focus row. -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Preset" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox x:Name="FrameLimitPresetComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource ControllerComboBoxStyle}"
                                          PlaceholderText="Choose preset"
                                          SelectionChanged="FrameLimitPresetComboBox_SelectionChanged"
                                          AutomationProperties.Name="Frame limiter preset">
                                    <ComboBoxItem Content="Unlimited" Tag="0" />
                                    <ComboBoxItem Content="30 FPS" Tag="30" />
                                    <ComboBoxItem Content="40 FPS" Tag="40" />
                                    <ComboBoxItem Content="60 FPS" Tag="60" />
                                    <ComboBoxItem Content="90 FPS" Tag="90" />
                                    <ComboBoxItem Content="120 FPS" Tag="120" />
                                    <ComboBoxItem Content="144 FPS" Tag="144" />
                                    <ComboBoxItem Content="165 FPS" Tag="165" />
                                    <ComboBoxItem Content="240 FPS" Tag="240" />
                                    <ComboBoxItem Content="360 FPS" Tag="360" />
                                </ComboBox>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,2" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Limiter type" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox x:Name="LimiterTypeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource ControllerComboBoxStyle}"
                                          SelectionChanged="LimiterTypeComboBox_SelectionChanged"
                                          AutomationProperties.Name="Limiter type">
                                    <ComboBoxItem Content="Async" />
                                    <ComboBoxItem Content="Front edge" />
                                    <ComboBoxItem Content="Back edge" />
                                    <ComboBoxItem Content="NVIDIA Reflex" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Limiter" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="LimiterEnabledToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ControllerToggleStyle}"
                                              Toggled="LimiterEnabledToggle_Toggled"
                                              AutomationProperties.Name="Frame limiter enabled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OSD -->
                    <Border Padding="14" CornerRadius="10"
                            Background="{StaticResource GameBarSurfaceBrush}"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="OSD" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Overlay" VerticalAlignment="Center" FontSize="16" />
                                <ToggleSwitch x:Name="OverlayToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ControllerToggleStyle}"
                                              Toggled="OverlayToggle_Toggled"
                                              AutomationProperties.Name="RTSS OSD visibility" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Size" FontSize="16" />
                                    <Slider x:Name="OsdZoomSlider"
                                            Style="{StaticResource ControllerSliderStyle}"
                                            Minimum="1" Maximum="8"
                                            StepFrequency="1" SmallChange="1" LargeChange="1"
                                            ValueChanged="OsdZoomSlider_ValueChanged"
                                            AutomationProperties.Name="RTSS OSD size" />
                                </StackPanel>
                                <TextBlock x:Name="OsdZoomValueText"
                                           Grid.Column="1"
                                           Text="--"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,13"
                                           HorizontalAlignment="Right"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Position" VerticalAlignment="Center" FontSize="16" />
                                <ComboBox x:Name="OsdPositionComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource ControllerComboBoxStyle}"
                                          PlaceholderText="Custom"
                                          SelectionChanged="OsdPositionComboBox_SelectionChanged"
                                          AutomationProperties.Name="RTSS OSD position">
                                    <ComboBoxItem Content="Top left" Tag="0" />
                                    <ComboBoxItem Content="Top center" Tag="1" />
                                    <ComboBoxItem Content="Top right" Tag="2" />
                                    <ComboBoxItem Content="Middle left" Tag="6" />
                                    <ComboBoxItem Content="Middle right" Tag="7" />
                                    <ComboBoxItem Content="Bottom left" Tag="3" />
                                    <ComboBoxItem Content="Bottom center" Tag="4" />
                                    <ComboBoxItem Content="Bottom right" Tag="5" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- System / integration -->
                    <Border Padding="14" CornerRadius="10"
                            Background="{StaticResource GameBarSurfaceBrush}"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="RTSS" VerticalAlignment="Center" FontSize="16" />
                                <Button x:Name="RtssActionButton" Grid.Column="1" Content="Start"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="RtssActionButton_Click" AutomationProperties.Name="Start or close RTSS" />
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Integration" VerticalAlignment="Center" FontSize="16" />
                                <Button x:Name="IntegrationActionButton" Grid.Column="1" Content="Install"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="IntegrationActionButton_Click" AutomationProperties.Name="Manage RTSS Game Bar integration" />
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="16" />
                                <Button x:Name="RefreshButton" Grid.Column="1"
                                        Width="52" Height="48" MinWidth="52" MinHeight="48"
                                        Padding="0"
                                        Click="RefreshButton_Click"
                                        AutomationProperties.Name="Refresh RTSS status"
                                        ToolTipService.ToolTip="Refresh RTSS status">
                                    <SymbolIcon Symbol="Sync" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="IntegrationVersionText" TextWrapping="Wrap" Opacity="0.62" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="D-pad navigates · A selects · B back/close"
                               TextWrapping="Wrap" Opacity="0.60" FontSize="12" TextAlignment="Center" />
                    <TextBlock x:Name="OperationText" TextWrapping="Wrap" Opacity="0.70" FontSize="12" />
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
